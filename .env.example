# Claude API key (script/description generation) - console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ElevenLabs API key (Urdu AI voice) - elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_chosen_voice_id_here

# Pexels API key (free background video clips) - pexels.com/api
PEXELS_API_KEY=your_pexels_key_here

# YouTube - client_secret.json file path (from Google Cloud Console)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# Channel settings
VIDEOS_PER_DAY=3
VIDEO_TOPIC_THEME=motivational Urdu life stories
